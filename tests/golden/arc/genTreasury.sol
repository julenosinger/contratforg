pragma solidity ^0.8.24;

interface IERC20 {
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

/// @title ArcTreasury — Multisig Treasury with payment streaming
/// @notice Generated by ContractForge for Arc Testnet (chainId 5042002)
/// @dev Approval threshold: 2 of 3 signers
contract ArcTreasury {
    address[] public signerList;
    mapping(address => bool) public isSigner;
    uint256 public threshold = 2;

    struct Proposal {
        address token;      // address(0) = native currency (gas token)
        address to;
        uint256 amount;
        uint256 approvals;
        bool executed;
        mapping(address => bool) approvedBy;
    }

    Proposal[] private _proposals;

    event ProposalCreated(uint256 indexed id, address token, address to, uint256 amount);
    event ProposalApproved(uint256 indexed id, address signer, uint256 totalApprovals);
    event ProposalExecuted(uint256 indexed id);
    event Deposit(address indexed from, address token, uint256 amount);
    event StreamCreated(uint256 indexed id, address recipient, address token, uint256 total, uint256 start, uint256 duration);
    event StreamWithdrawn(uint256 indexed id, uint256 amount);

    modifier onlySigner() { require(isSigner[msg.sender], "not a signer"); _; }

    constructor() {
        signerList.push(0x1800182039115843917209550374210081021218);
        isSigner[0x1800182039115843917209550374210081021218] = true;
        signerList.push(0x1668943534033590177508701071003389935845);
        isSigner[0x1668943534033590177508701071003389935845] = true;
        signerList.push(0x2062659049280351396611248980632053126556);
        isSigner[0x2062659049280351396611248980632053126556] = true;
        require(threshold > 0 && threshold <= signerList.length, "invalid threshold");
    }

    receive() external payable { emit Deposit(msg.sender, address(0), msg.value); }

    function depositToken(address token, uint256 amount) external {
        require(IERC20(token).transferFrom(msg.sender, address(this), amount), "transferFrom failed");
        emit Deposit(msg.sender, token, amount);
    }

    function propose(address token, address to, uint256 amount) external onlySigner returns (uint256 id) {
        id = _proposals.length;
        _proposals.push();
        Proposal storage p = _proposals[id];
        p.token = token; p.to = to; p.amount = amount;
        emit ProposalCreated(id, token, to, amount);
        _approve(id);
    }

    function approve(uint256 id) external onlySigner { _approve(id); }

    function _approve(uint256 id) internal {
        Proposal storage p = _proposals[id];
        require(!p.executed, "already executed");
        require(!p.approvedBy[msg.sender], "already approved");
        p.approvedBy[msg.sender] = true;
        p.approvals += 1;
        emit ProposalApproved(id, msg.sender, p.approvals);
        if (p.approvals >= threshold) _execute(id);
    }

    function _execute(uint256 id) internal {
        Proposal storage p = _proposals[id];
        require(!p.executed, "already executed");
        p.executed = true;
        if (p.token == address(0)) {
            (bool ok, ) = p.to.call{value: p.amount}("");
            require(ok, "native transfer failed");
        } else {
            require(IERC20(p.token).transfer(p.to, p.amount), "token transfer failed");
        }
        emit ProposalExecuted(id);
    }

    function proposalsLength() external view returns (uint256) { return _proposals.length; }

    function proposalInfo(uint256 id) external view returns (address token, address to, uint256 amount, uint256 approvals, bool executed) {
        Proposal storage p = _proposals[id];
        return (p.token, p.to, p.amount, p.approvals, p.executed);
    }

    // ---------------- Payment streaming (linear vesting) ----------------
    struct Stream {
        address recipient;
        address token; // address(0) = native
        uint256 total;
        uint256 withdrawn;
        uint256 start;
        uint256 duration;
        bool active;
    }
    Stream[] public streams;

    function createStream(address recipient, address token, uint256 total, uint256 start, uint256 duration) external onlySigner returns (uint256 id) {
        require(duration > 0, "invalid duration");
        id = streams.length;
        streams.push(Stream({ recipient: recipient, token: token, total: total, withdrawn: 0, start: start, duration: duration, active: true }));
        emit StreamCreated(id, recipient, token, total, start, duration);
    }

    function streamed(uint256 id) public view returns (uint256) {
        Stream storage s = streams[id];
        if (block.timestamp < s.start) return 0;
        uint256 elapsed = block.timestamp - s.start;
        if (elapsed >= s.duration) return s.total;
        return (s.total * elapsed) / s.duration;
    }

    function withdrawStream(uint256 id) external {
        Stream storage s = streams[id];
        require(s.active, "inactive stream");
        require(msg.sender == s.recipient, "not recipient");
        uint256 available = streamed(id) - s.withdrawn;
        require(available > 0, "nothing to withdraw");
        s.withdrawn += available;
        if (s.token == address(0)) {
            (bool ok, ) = s.recipient.call{value: available}("");
            require(ok, "native transfer failed");
        } else {
            require(IERC20(s.token).transfer(s.recipient, available), "token transfer failed");
        }
        emit StreamWithdrawn(id, available);
    }
}