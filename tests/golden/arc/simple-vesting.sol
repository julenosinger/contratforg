pragma solidity ^0.8.24;

interface IERC20 {
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function transfer(address to, uint256 amount) external returns (bool);
}

/// @title ArcVesting — Linear vesting with cliff
/// @notice Generated by ContractForge for Arc Testnet (chainId 5042002)
contract ArcVesting {
    IERC20 public token = IERC20(0x2916570661279426764209465153711134050312);
    address public beneficiary = 0x2076099009287778339808688539271449779540;
    address public funder;
    uint256 public totalAmount = 120000 * 10**6;
    uint256 public released;
    uint256 public start;
    uint256 public cliffDuration = 90 days;
    uint256 public totalDuration = 365 days;
    bool public funded;

    event Funded(uint256 amount);
    event Released(uint256 amount);

    constructor() {
        funder = msg.sender;
    }

    /// @notice The deployer deposits the tokens. Vesting (and the cliff) start now, not at deployment.
    function fund() external {
        require(msg.sender == funder, "only funder");
        require(!funded, "already funded");
        funded = true;
        start = block.timestamp;
        emit Funded(totalAmount);
        require(token.transferFrom(funder, address(this), totalAmount), "transferFrom failed");
    }

    function vestedAmount() public view returns (uint256) {
        if (!funded) return 0;
        if (block.timestamp < start + cliffDuration) return 0;
        if (block.timestamp >= start + totalDuration) return totalAmount;
        return (totalAmount * (block.timestamp - start)) / totalDuration;
    }

    function releasable() public view returns (uint256) {
        return vestedAmount() - released;
    }

    function release() external {
        require(funded, "not funded");
        uint256 amount = releasable();
        require(amount > 0, "nothing to release");
        released += amount;
        require(token.transfer(beneficiary, amount), "transfer failed");
        emit Released(amount);
    }
}