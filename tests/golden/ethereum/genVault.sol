pragma solidity ^0.8.24;

interface IERC20 {
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

/// @title ArcYieldVault — ERC-4626-style Vault (deposit/withdraw with proportional shares)
/// @notice Generated by ContractForge for Ethereum (chainId 1)
/// @dev Performance fee: 1000 bps on accrued yield, paid to the owner on withdrawal
contract ArcYieldVault {
    string public name = "ArcYieldVault Shares";
    string public symbol = "avUSDC";
    uint8  public decimals = 18;

    IERC20 public asset = IERC20(0x1715845657031418236618493247352301630348);
    uint256 public totalSupply;      // total shares issued
    uint256 public depositCap = 0 * 10**6; // 0 = unlimited (assumes a 6-decimal asset)
    uint256 public constant PERF_FEE_BPS = 1000;
    address public owner;

    mapping(address => uint256) public balanceOf;

    event Deposit(address indexed sender, address indexed owner, uint256 assets, uint256 shares);
    event Withdraw(address indexed sender, address indexed owner, uint256 assets, uint256 shares, uint256 perfFee);
    
    constructor() { owner = msg.sender; }

    /// @notice Total assets under management by the vault
    function totalAssets() public view returns (uint256) {
        return asset.balanceOf(address(this));
    }

    function convertToShares(uint256 assets) public view returns (uint256) {
        return totalSupply == 0 ? assets : (assets * totalSupply) / totalAssets();
    }

    function convertToAssets(uint256 shares) public view returns (uint256) {
        return totalSupply == 0 ? shares : (shares * totalAssets()) / totalSupply;
    }

    /// @notice Deposits 'assets' of the underlying token and receives proportional shares
    function deposit(uint256 assets, address receiver) external returns (uint256 shares) {
        require(assets > 0, "zero deposit");
        if (depositCap > 0) require(totalAssets() + assets <= depositCap, "exceeds deposit cap");

        shares = convertToShares(assets);
        require(shares > 0, "zero shares");

        require(asset.transferFrom(msg.sender, address(this), assets), "transferFrom failed");

        totalSupply += shares;
        balanceOf[receiver] += shares;

        emit Deposit(msg.sender, receiver, assets, shares);
    }

    /// @notice Burns 'shares' and returns proportional assets (with a performance fee on the gain)
    function redeem(uint256 shares, address receiver) external returns (uint256 assetsOut) {
        require(balanceOf[msg.sender] >= shares, "insufficient shares");

        uint256 grossAssets = convertToAssets(shares);

        // performance fee applies only to the proportional gain (simple heuristic:
        // compares the current per-share value against an initial 1:1 ratio)
        uint256 costBasis = shares; // 1 share = 1 base unit at creation
        uint256 perfFee = 0;
        if (grossAssets > costBasis && PERF_FEE_BPS > 0) {
            uint256 gain = grossAssets - costBasis;
            perfFee = (gain * PERF_FEE_BPS) / 10000;
        }
        assetsOut = grossAssets - perfFee;

        balanceOf[msg.sender] -= shares;
        totalSupply -= shares;

        require(asset.transfer(receiver, assetsOut), "transfer failed");
        if (perfFee > 0) require(asset.transfer(owner, perfFee), "fee transfer failed");

        emit Withdraw(msg.sender, receiver, assetsOut, shares, perfFee);
    }

    function setDepositCap(uint256 newCap) external {
        require(msg.sender == owner, "not owner");
        depositCap = newCap;
    }
}