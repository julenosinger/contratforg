{
 "#labStatus": "<span id=\"labStatus\" class=\"lab-status\" role=\"status\">Not started</span>",
 "#labContract": "<div id=\"labContract\" class=\"lab-note\" style=\"margin-bottom:12px;\"></div>",
 "#labArgs": "<div id=\"labArgs\" style=\"display:none;margin-bottom:14px;\"></div>",
 "#lab_acting": "<select id=\"lab_acting\" data-onchange=\"labSelectAccount()\" aria-label=\"Acting account\"></select>",
 "#lab_acting_addr": "<code id=\"lab_acting_addr\" class=\"lab-addr\"></code>",
 "#lab_balances": "<div id=\"lab_balances\" class=\"lab-balances\"><span class=\"lab-note\">Balances appear once the contract is loaded.</span></div>",
 "#lab_time": "<div id=\"lab_time\" class=\"lab-time\">Not started</div>",
 "#lab_token": "<select id=\"lab_token\" aria-label=\"Token\"><option value=\"usdc\">USDC</option><option value=\"eurc\">EURC</option></select>",
 "#lab_token_amt": "<input id=\"lab_token_amt\" value=\"1000\" aria-label=\"Amount\">",
 "#lab_approve_all": "<input type=\"checkbox\" id=\"lab_approve_all\">",
 "#lab_filter": "<div class=\"pill-row\" id=\"lab_filter\"><div class=\"pill active\" data-filter=\"all\" data-onclick=\"labFilter('all',this)\">All</div><div class=\"pill\" data-filter=\"read\" data-onclick=\"labFilter('read',this)\">Read</div><div class=\"pill\" data-filter=\"write\" data-onclick=\"labFilter('write',this)\">Write</div><div class=\"pill\" data-filter=\"event\" data-onclick=\"labFilter('event',this)\">Events</div></div>",
 "#lab_search": "<input id=\"lab_search\" class=\"pg-search\" placeholder=\"Search functions…\" aria-label=\"Search functions\">",
 "#lab_functions": "<div id=\"lab_functions\"></div>",
 "#lab_txs": "<div id=\"lab_txs\" class=\"pg-calls\" style=\"display:none;\"></div>",
 "#lab_log": "<div class=\"console\" id=\"lab_log\" style=\"margin-top:14px;\"><div class=\"line\"><span class=\"t\">[boot]</span><span class=\"msg\">Press \"Load current contract\" to start.</span></div></div>",
 "#sec-lab .lab-bar": "<div class=\"lab-bar\"><span id=\"labStatus\" class=\"lab-status\" role=\"status\">Not started</span><div class=\"btnrow\" style=\"margin:0;\"><button class=\"btn btn-primary\" data-onclick=\"labLoadContract()\">Load current contract</button><button class=\"btn btn-ghost\" data-onclick=\"labSmoke()\">Quick check</button></div></div>",
 "#sec-lab .lab-grid": "<div class=\"lab-grid\"><div class=\"lab-card\"><h4>Time</h4><div id=\"lab_time\" class=\"lab-time\">Not started</div><div class=\"btnrow\" style=\"margin:8px 0;flex-wrap:wrap;\"><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labAdvance(3600)\">+1 hour</button><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labAdvance(86400)\">+1 day</button><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labAdvance(604800)\">+7 days</button><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labAdvance(2592000)\">+30 days</button></div><div class=\"lab-inline\"><input id=\"lab_time_n\" type=\"number\" min=\"1\" value=\"1\" aria-label=\"Amount of time\"><select id=\"lab_time_unit\" aria-label=\"Unit\"><option value=\"60\">minutes</option><option value=\"3600\">hours</option><option value=\"86400\" selected=\"\">days</option></select><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labAdvanceCustom()\">Move time</button></div><div class=\"lab-inline\" style=\"margin-top:6px;\"><input id=\"lab_mine_n\" type=\"number\" min=\"1\" value=\"10\" aria-label=\"Blocks\"><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labMine()\">Mine blocks</button></div></div><div class=\"lab-card\"><h4>Test tokens</h4><div class=\"lab-inline\"><select id=\"lab_token\" aria-label=\"Token\"><option value=\"usdc\">USDC</option><option value=\"eurc\">EURC</option></select><input id=\"lab_token_amt\" value=\"1000\" aria-label=\"Amount\"><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labMint()\">Mint to acting account</button></div><div class=\"lab-inline\" style=\"margin-top:10px;\"><button class=\"btn btn-ghost lab-mini\" data-onclick=\"labApprove()\">Approve the contract to spend it</button><label class=\"lab-check\"><input type=\"checkbox\" id=\"lab_approve_all\"> for all test accounts</label></div><p class=\"lab-note\" style=\"margin-top:8px;\">Contracts that hard-code the real USDC or EURC address work unchanged: the test tokens are placed at those addresses.</p></div></div>"
}
